# ============================================
# Fainens - Personal Finance Bookkeeping App
# Environment Variables Configuration
# ============================================

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Must be the same origin as the browser (Vite dev server) so the session cookie is set on the UI origin.
# Vite proxies /api → backend :3000 (see frontend/vite.config.ts). Register this exact URI in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Where OAuth sends the user after login (dashboard). Match your Vite port / production URL.
FRONTEND_URL=http://localhost:8080
# Comma-separated origins allowed to send credentialed browser requests. Set your production URL here.
CORS_ORIGINS=http://localhost:8080
# Optional identity used only when LOCAL_AUTH_BYPASS=true in development.
LOCAL_AUTH_EMAIL=local-dev@fainens.test
HOST=0.0.0.0
PORT=3000

# The email address that is allowed to log in (single-user mode)
ALLOWED_EMAIL="your-email@example.com"

# --------------------------------------------
# Session Security (Required)
# --------------------------------------------
# Generate a strong random string (64+ characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-random-64-character-secret-key-for-development"

# --------------------------------------------
# Cloudflare R2 Configuration (Optional)
# --------------------------------------------
# Required only if you want attachment upload functionality
# Get these from Cloudflare dashboard: https://dash.cloudflare.com
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=fainens-attachments
# R2_PUBLIC_URL=https://your-bucket.pub-r2.dev

# --------------------------------------------
# Redis (caching — optional; app works without it, slower)
# --------------------------------------------
# Local backend (Redis on your machine):
REDIS_URL=redis://127.0.0.1:6379
# Docker Compose (service name `redis` on the compose network):
# REDIS_URL=redis://redis:6379
# Use this for local development:
# REDIS_URL=redis://localhost:6379

# Background execution. `interval` keeps the compatibility in-process runner;
# production queue mode requires the standalone backend worker container.
JOB_RUNNER_MODE=interval
WORKER_MAINTENANCE_CONCURRENCY=2
WORKER_RECURRING_CONCURRENCY=1
WORKER_AGENT_CONCURRENCY=1
WORKER_AGENT_TIMEOUT_MS=45000

# --------------------------------------------
# App Configuration
# --------------------------------------------
# Set to 'production' for production deployment
NODE_ENV=development

# --------------------------------------------
# OpenRouter API (LLM Insights)
# --------------------------------------------
# Get your API key from: https://openrouter.ai/keys
# This enables AI-powered spending insights and budget analysis
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
# Optional URL sent as the provider HTTP-Referer; defaults to FRONTEND_URL.
OPENROUTER_HTTP_REFERER=http://localhost:8080
# Model used by the interactive finance agent
OPENROUTER_MODEL=google/gemini-3.7-flash
AGENT_OPENROUTER_MODEL=z-ai/glm-5.3-flash

# --------------------------------------------
# Frontend Configuration (Build time)
# --------------------------------------------
# URL where backend API is hosted
# For Docker: leave as /api (nginx proxies it)
# For local dev: http://localhost:3000
VITE_API_BASE=/api
VITE_DEV_PORT=8080
VITE_API_PROXY_TARGET=http://localhost:3000

# Docker deployment defaults. Change these for your registry/account.
FAINENS_IMAGE_REGISTRY=docker.io
FAINENS_IMAGE_NAMESPACE=fainens
FAINENS_IMAGE_TAG=latest
FAINENS_FRONTEND_PORT=8082
